<div class="futuristic-container">
  <div class="header">
    <h1 class="glow">Welcome to the Quantum Question Portal</h1>
    <p class="subheader">Unlock the knowledge of tomorrow, today</p>
  </div>
  
  <div class="content">
    <% if user_signed_in? %>
      <h2 class="section-title">Recent Inquiries</h2>
      <div class="question-grid">
        <% @questions.each do |question| %>
          <div class="question-card">
            <h5 class="question-title"><%= link_to question.title, question_path(question) %></h5>
            <p class="question-preview"><%= truncate(question.contents, length: 100) %></p>
            <small class="question-meta">Inquired by <%= question.user.email %> on <%= question.created_at.strftime("%B %d, %Y") %></small>
          </div>
        <% end %>
      </div>

      <h3 class="section-title">Initiate New Inquiry</h3>
      <%= form_with(model: Question.new, local: true, class: 'futuristic-form') do |form| %>
        <div class="form-group">
          <%= form.label :title, 'Inquiry Title' %>
          <%= form.text_field :title, class: 'form-control' %>
        </div>
        <div class="form-group">
          <%= form.label :contents, 'Inquiry Details' %>
          <%= form.text_area :contents, class: 'form-control', rows: 5 %>
        </div>
        <%= form.submit 'Submit Inquiry', class: 'btn btn-neon' %>
      <% end %>
    <% else %>
      <%= link_to "Access Portal", new_user_session_path, class: "btn btn-neon" %>
    <% end %>
  </div>
</div>

<style>
  body {
    background-color: #0a0a2a;
    color: #e0e0ff;
    font-family: 'Roboto', sans-serif;
  }

  .futuristic-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem;
  }

  .header {
    text-align: center;
    margin-bottom: 3rem;
  }


  .glow {
    font-size: 3rem;
    color: #00ffff;
    text-shadow: 0 0 10px #00ffff, 0 0 20px #00ffff, 0 0 30px #00ffff;
  }

  .subheader {
    font-size: 1.2rem;
    color: #b0b0ff;
  }

  .section-title {
    color: #00ffff;
    border-bottom: 2px solid #00ffff;
    padding-bottom: 0.5rem;
    margin-bottom: 1.5rem;
  }

  .question-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .question-card {
    background-color: rgba(255, 255, 255, 0.1);
    border-radius: 10px;
    padding: 1.5rem;
    transition: all 0.3s ease;
  }

  .question-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 5px 15px rgba(0, 255, 255, 0.2);
  }

  .question-title a {
    color: #00ffff;
    text-decoration: none;
  }

  .question-preview {
    color: #d0d0ff;
  }

  .question-meta {
    color: #8080ff;
  }

  .futuristic-form .form-control {
    background-color: rgba(255, 255, 255, 0.1);
    border: none;
    border-bottom: 2px solid #00ffff;
    color: #e0e0ff;
    padding: 0.5rem;
  }

  .btn-neon {
    background-color: transparent;
    border: 2px solid #00ffff;
    color: #00ffff;
    padding: 0.75rem 1.5rem;  /* Increased vertical padding */
    text-transform: uppercase;
    letter-spacing: 2px;
    transition: all 0.3s ease;
  }

  .btn-neon:hover {
    background-color: #00ffff;
    color: #0a0a2a;
    box-shadow: 0 0 10px #00ffff, 0 0 20px #00ffff;
  }
</style>
