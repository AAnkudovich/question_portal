<style>
.quantum-container {
  background: linear-gradient(135deg, #000000, #1a1a2e);
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 2rem;
  font-family: 'Arial', sans-serif;
}

.quantum-title {
  font-size: 2.5rem;
  color: #00ffff;
  text-shadow: 0 0 10px #00ffff, 0 0 20px #00ffff;
  margin-bottom: 2rem;
}

.quantum-panel {
  background: rgba(26, 26, 46, 0.8);
  border-radius: 15px;
  padding: 2rem;
  box-shadow: 0 0 20px rgba(0, 255, 255, 0.3);
  display: flex;
  flex-wrap: wrap;
  gap: 2rem;
  max-width: 1000px;
  width: 100%;
}

.quantum-form, .quantum-result {
  flex: 1;
  min-width: 300px;
}

.quantum-input-group {
  margin-bottom: 1.5rem;
}

.quantum-label {
  display: block;
  color: #00ffff;
  margin-bottom: 0.5rem;
  font-size: 1rem;
}

.quantum-input {
  width: 100%;
  padding: 0.75rem;
  background: rgba(0, 255, 255, 0.1);
  border: 1px solid #00ffff;
  border-radius: 5px;
  color: #ffffff;
  font-size: 1rem;
}

.quantum-button {
  background: linear-gradient(45deg, #00ffff, #00ccff);
  border: none;
  padding: 0.75rem 1.5rem;
  color: #000000;
  font-weight: bold;
  border-radius: 5px;
  cursor: pointer;
  transition: all 0.3s ease;
}

.quantum-button:hover {
  transform: scale(1.05);
  box-shadow: 0 0 15px rgba(0, 255, 255, 0.5);
}

.quantum-result {
  background: rgba(0, 255, 255, 0.1);
  border-radius: 10px;
  padding: 1.5rem;
}

.quantum-result-title {
  color: #00ffff;
  font-size: 1.5rem;
  margin-bottom: 1rem;
}

.quantum-result-item {
  display: flex;
  justify-content: space-between;
  margin-bottom: 1rem;
}

.quantum-result-label {
  color: #ffffff;
}

.quantum-result-value {
  color: #00ffff;
  font-weight: bold;
}

.quantum-fade-in {
  animation: quantumFadeIn 0.5s ease-in-out;
}

@keyframes quantumFadeIn {
  from { opacity: 0; transform: translateY(-10px); }
  to { opacity: 1; transform: translateY(0); }
}

@media (max-width: 768px) {
  .quantum-panel {
    flex-direction: column;
  }
}
</style>

<div class="quantum-container">
  <h1 class="quantum-title">Quantum Pension Projector</h1>
  
  <div class="quantum-panel">
    <div class="quantum-form">
      <%= form_tag('#', id: 'pension-calculator-form') do %>
        <div class="quantum-input-group">
          <%= label_tag :initial_investment, 'Initial Investment (€)', class: 'quantum-label' %>
          <%= number_field_tag :initial_investment, nil, class: 'quantum-input', required: true, step: 'any' %>
        </div>
        <div class="quantum-input-group">
          <%= label_tag :monthly_contribution, 'Monthly Contribution (€)', class: 'quantum-label' %>
          <%= number_field_tag :monthly_contribution, nil, class: 'quantum-input', required: true, step: 'any' %>
        </div>
        <div class="quantum-input-group">
          <%= label_tag :annual_interest_rate, 'Annual Interest Rate (%)', class: 'quantum-label' %>
          <%= number_field_tag :annual_interest_rate, nil, class: 'quantum-input', step: '0.1', required: true %>
        </div>
        <div class="quantum-input-group">
          <%= label_tag :years, 'Time Horizon (Years)', class: 'quantum-label' %>
          <%= number_field_tag :years, nil, class: 'quantum-input', required: true %>
        </div>
        <%= submit_tag 'Project Future', class: 'quantum-button' %>
      <% end %>
    </div>
    <div id="result" class="quantum-result"></div>
  </div>
</div>

<% content_for :javascript do %>
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const form = document.getElementById('pension-calculator-form');
      const resultDiv = document.getElementById('result');

      form.addEventListener('submit', function(e) {
        e.preventDefault();
        
        const initialInvestment = parseFloat(document.getElementById('initial_investment').value);
        const monthlyContribution = parseFloat(document.getElementById('monthly_contribution').value);
        const annualInterestRate = parseFloat(document.getElementById('annual_interest_rate').value) / 100;
        const years = parseInt(document.getElementById('years').value);

        const monthlyRate = annualInterestRate / 12;
        const months = years * 12;
        const totalContributions = initialInvestment + (monthlyContribution * months);
        let futureValue = initialInvestment;

        for (let i = 0; i < months; i++) {
          futureValue += monthlyContribution;
          futureValue *= (1 + monthlyRate);
        }

        const totalInterest = futureValue - totalContributions;

        const resultHtml = `
          <h2 class="quantum-result-title">Quantum Projection:</h2>
          <div class="quantum-result-item">
            <span class="quantum-result-label">Future Value:</span>
            <span class="quantum-result-value">€${futureValue.toFixed(2)}</span>
          </div>
          <div class="quantum-result-item">
            <span class="quantum-result-label">Total Contributions:</span>
            <span class="quantum-result-value">€${totalContributions.toFixed(2)}</span>
          </div>
          <div class="quantum-result-item">
            <span class="quantum-result-label">Total Interest Earned:</span>
            <span class="quantum-result-value">€${totalInterest.toFixed(2)}</span>
          </div>
        `;

        resultDiv.innerHTML = resultHtml;
        resultDiv.classList.add('quantum-fade-in');
        setTimeout(() => resultDiv.classList.remove('quantum-fade-in'), 500);
      });
    });
  </script>
<% end %>